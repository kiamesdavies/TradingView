# Copy to deploy/.env.local (gitignored) and fill in.
PROJECT_ID=eodview-prod
# Your Google account (runs gcloud/Terraform; admin SSH via IAP) and who may log in through Cloudflare Access
GCP_ACCOUNT=you@example.com
TF_VAR_admin_user=you@example.com
TF_VAR_access_emails='["you@example.com"]'
TF_VAR_hostname=charts.example.com
TF_VAR_cloudflare_zone_name=example.com
# Cloudflare API token with: Account > Cloudflare Tunnel: Edit, Account > Access: Apps and Policies: Edit,
# Account > Access: Service Tokens: Edit, Zone > DNS: Edit, Zone > Zone: Read (scoped to your zone/account).
CLOUDFLARE_API_TOKEN=
